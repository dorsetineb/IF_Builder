{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "if-builder",
  "version": "0.8.6",
  "identifier": "com.ifbuildr.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IF Builder",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IGF1dG91cGRhdGUgcHVibGljIGtleQpSV1N5T2E4WUpYNEI0bmdqOUNwZnhmUTlhQ2cyeERiR1Z0MHB2Qnh6RkYwV1BkWG9XQnhwK0k2Wg==",
      "endpoints": [
        "https://if-builder.vercel.app/api/update?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ]
    }
  }
}
